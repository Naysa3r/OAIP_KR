unit AdminUnit;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls;

type
  TQuestion = record
    Text: string[255];          // Текст вопроса
    Answers: array[0..3] of string[100]; // 4 варианта ответа
    CorrectIndex: Integer;       // Номер верного (0..3)
  end;
  TFormAdmin = class(TForm)
    OpenDialog1: TOpenDialog;
    BtnOpen: TButton;
    BtnCreate: TButton;
    Panel1: TPanel;
    ListBoxQuestions: TListBox;
    GroupBox1: TGroupBox;
    LabelStatus: TLabel;
    Memo1: TMemo;
    Edit1: TEdit;
    BtnAdd: TButton;
    Button4: TButton;
    Button5: TButton;
    RadioButton1: TRadioButton;
    Edit2: TEdit;
    RadioButton2: TRadioButton;
    Edit3: TEdit;
    RadioButton3: TRadioButton;
    Edit4: TEdit;
    RadioButton4: TRadioButton;
    SaveDialog1: TSaveDialog;
    procedure BtnCreateClick(Sender: TObject);
    procedure BtnAddClick(Sender: TObject);
    procedure BtnOpenClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
    var
      CurrentFilePath: string; // Глобальная переменная для хранения пути к открытому пакет
  end;

var
  FormAdmin: TFormAdmin;
  F: file of TQuestion;         // Файл средствами языка
  Questions: array of TQuestion; // Динамическая структура данных

implementation

{$R *.dfm}

procedure TFormAdmin.BtnAddClick(Sender: TObject);
var
  NewIdx: Integer;
begin
  // 1. Проверяем, выбран ли файл пакета
  if CurrentFilePath = '' then
  begin
    ShowMessage('Сначала создайте или откройте пакет вопросов!');
    Exit;
  end;

  // 2. Увеличиваем размер динамического массива (выполнение требования структуры данных)
  NewIdx := Length(Questions); // Индекс нового элемента
  SetLength(Questions, NewIdx + 1);

  // 3. Заполняем структуру данными из интерфейса
  Questions[NewIdx].Text := ShortString(Memo1.Text);
  Questions[NewIdx].Answers[0] := ShortString(Edit1.Text);
  Questions[NewIdx].Answers[1] := ShortString(Edit2.Text);
  Questions[NewIdx].Answers[2] := ShortString(Edit3.Text);
  Questions[NewIdx].Answers[3] := ShortString(Edit4.Text);

  // Определяем индекс правильного ответа
  if RadioButton1.Checked then Questions[NewIdx].CorrectIndex := 0
  else if RadioButton2.Checked then Questions[NewIdx].CorrectIndex := 1
  else if RadioButton3.Checked then Questions[NewIdx].CorrectIndex := 2
  else Questions[NewIdx].CorrectIndex := 3;

  // 4. Обновляем визуальный список ListBox
  // Добавляем туда начало вопроса, чтобы админ ориентировался
  ListBoxQuestions.Items.Add(IntToStr(NewIdx + 1) + '. ' + Copy(Memo1.Text, 1, 30) + '...');

  // 5. Очищаем поля для ввода следующего вопроса
  Memo1.Clear;
  Edit1.Clear; Edit2.Clear; Edit3.Clear; Edit4.Clear;
  RadioButton1.Checked := True;

  Memo1.SetFocus; // Возвращаем курсор в поле текста вопроса
end;

procedure TFormAdmin.BtnCreateClick(Sender: TObject);
begin
  if SaveDialog1.Execute then
  begin
    CurrentFilePath := SaveDialog1.FileName;

    AssignFile(F, CurrentFilePath); // Связываем файловую переменную с путем
    Rewrite(F);                    // Создаем/перезаписываем файл (пустой)
    CloseFile(F);                   // Закрываем

    SetLength(Questions, 0);        // Очищаем динамический массив в памяти
    ListBoxQuestions.Clear;
    LabelStatus.Caption := 'Пакет: ' + ExtractFileName(CurrentFilePath);
  end;
end;
procedure TFormAdmin.BtnOpenClick(Sender: TObject);
var
  TempQ: TQuestion;
begin
  if OpenDialog1.Execute then
  begin
    CurrentFilePath := OpenDialog1.FileName;

    // Связываем файл и открываем для чтения
    AssignFile(F, CurrentFilePath);
    Reset(F); // Reset открывает существующий файл

    try
      // 1. Очищаем старые данные в памяти
      SetLength(Questions, 0);
      ListBoxQuestions.Items.Clear;

      // 2. Цикл чтения до конца файла (Алгоритм загрузки)
      while not Eof(F) do
      begin
        Read(F, TempQ); // Читаем одну запись

        // Увеличиваем массив и добавляем данные
        SetLength(Questions, Length(Questions) + 1);
        Questions[High(Questions)] := TempQ;

        // Добавляем заголовок в визуальный список
        ListBoxQuestions.Items.Add(IntToStr(Length(Questions)) + '. ' +
                                   Copy(string(TempQ.Text), 1, 30) + '...');
      end;

      LabelStatus.Caption := 'Пакет: ' + ExtractFileName(CurrentFilePath);
      ShowMessage('Загружено вопросов: ' + IntToStr(Length(Questions)));

    finally
      CloseFile(F);
    end;
  end;
end;

end.
