unit AdminUnit;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls;

type
  TQuestion = record
    Text: string[255];          // Текст вопроса
    Answers: array[0..3] of string[100]; // 4 варианта ответа
    CorrectIndex: Integer;       // Номер верного (0..3)
  end;
  TFormAdmin = class(TForm)
    OpenDialog1: TOpenDialog;
    BtnOpen: TButton;
    BtnCreate: TButton;
    Panel1: TPanel;
    ListBoxQuestions: TListBox;
    GroupBox1: TGroupBox;
    LabelStatus: TLabel;
    Memo1: TMemo;
    Edit1: TEdit;
    BtnAdd: TButton;
    BtnDelete: TButton;
    BtnSave: TButton;
    RadioButton1: TRadioButton;
    Edit2: TEdit;
    RadioButton2: TRadioButton;
    Edit3: TEdit;
    RadioButton3: TRadioButton;
    Edit4: TEdit;
    RadioButton4: TRadioButton;
    SaveDialog1: TSaveDialog;
    BtnClearFields: TButton;
    procedure BtnCreateClick(Sender: TObject);
    procedure BtnAddClick(Sender: TObject);
    procedure BtnOpenClick(Sender: TObject);
    procedure ListBoxQuestionsClick(Sender: TObject);
    procedure BtnSaveClick(Sender: TObject);
    procedure BtnDeleteClick(Sender: TObject);
    procedure BtnClearFieldsClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
    var
      CurrentFilePath: string; // Глобальная переменная для хранения пути к открытому пакету
  end;

var
  FormAdmin: TFormAdmin;
  F: file of TQuestion;         // Файл средствами языка
  Questions: array of TQuestion; // Динамическая структура данных

implementation

{$R *.dfm}

procedure TFormAdmin.BtnAddClick(Sender: TObject);
var
  NewIdx: Integer;
begin
  // Проверка, выбран ли файл пакета
  if CurrentFilePath = '' then
  begin
    ShowMessage('Сначала создайте или откройте пакет вопросов!');
    Exit;
  end;

  // Увеличение размера динамического массива
  NewIdx := Length(Questions); // Индекс нового элемента
  SetLength(Questions, NewIdx + 1);

  // Заполнение структуры данными из интерфейса
  Questions[NewIdx].Text := ShortString(Memo1.Text);
  Questions[NewIdx].Answers[0] := ShortString(Edit1.Text);
  Questions[NewIdx].Answers[1] := ShortString(Edit2.Text);
  Questions[NewIdx].Answers[2] := ShortString(Edit3.Text);
  Questions[NewIdx].Answers[3] := ShortString(Edit4.Text);

  // Определение индекса правильного ответа
  if RadioButton1.Checked then Questions[NewIdx].CorrectIndex := 0
  else if RadioButton2.Checked then Questions[NewIdx].CorrectIndex := 1
  else if RadioButton3.Checked then Questions[NewIdx].CorrectIndex := 2
  else Questions[NewIdx].CorrectIndex := 3;

  // Обновление визуального списка ListBox
  // Вписывание начала вопроса для наглядности выбираемого элемента
  ListBoxQuestions.Items.Add(IntToStr(NewIdx + 1) + '. ' + Copy(Memo1.Text, 1, 30) + '...');

  // Очистка поля для ввода следующего вопроса
  Memo1.Clear;
  Edit1.Clear; Edit2.Clear; Edit3.Clear; Edit4.Clear;
  RadioButton1.Checked := True;

  Memo1.SetFocus; // Возвращение курсора в поле текста вопроса
end;

procedure TFormAdmin.BtnClearFieldsClick(Sender: TObject);
begin
  // Очистка текстовых компонентов
  Memo1.Clear;
  Edit1.Clear;
  Edit2.Clear;
  Edit3.Clear;
  Edit4.Clear;

  // По-умолчанию выбран первый вариант
  RadioButton1.Checked := True;

  // Убирается выделение вопроса для наглядности, что вопрос создается, а не редактируется
  ListBoxQuestions.ItemIndex := -1;

  // Устанавливается фокус на текст вопроса для быстрого ввода
  Memo1.SetFocus;
end;

procedure TFormAdmin.BtnCreateClick(Sender: TObject);
begin
  if SaveDialog1.Execute then
  begin
    CurrentFilePath := SaveDialog1.FileName;

    AssignFile(F, CurrentFilePath); // Связка файловой переменной с путем
    Rewrite(F);                    // Создание/перезапись файла
    CloseFile(F);                   // Закрытие

    SetLength(Questions, 0);        // Очистка динамического массива в памяти
    ListBoxQuestions.Clear;
    LabelStatus.Caption := 'Пакет: ' + ExtractFileName(CurrentFilePath);
  end;
end;
procedure TFormAdmin.BtnDeleteClick(Sender: TObject);
var
  Idx, i: Integer;
begin
  // Получение индекса выделенного вопроса
  Idx := ListBoxQuestions.ItemIndex;

  // Проверка: выделен ли вопрос
  if Idx < 0 then
  begin
    ShowMessage('Выберите вопрос для удаления!');
    Exit;
  end;

  // Сдвиг элементов массива влево
  // Затирается удаляемый элемент следующим, и так до конца
  for i := Idx to High(Questions) - 1 do
  begin
    Questions[i] := Questions[i + 1];
  end;

  // Уменьшение размера динамического массива на 1
  SetLength(Questions, Length(Questions) - 1);

  // Обновление интерфейса
  // Перерисовывание ListBox, так как нумерация и названия могли измениться
  ListBoxQuestions.Items.Clear;
  for i := 0 to High(Questions) do
  begin
    ListBoxQuestions.Items.Add(IntToStr(i + 1) + '. ' +
                               Copy(string(Questions[i].Text), 1, 30) + '...');
  end;

  // Очищаение поля ввода, так как удаленного вопроса больше нет
  Memo1.Clear;
  Edit1.Clear; Edit2.Clear; Edit3.Clear; Edit4.Clear;

  ShowMessage('Вопрос удален из памяти. Не забудьте нажать "Сохранить"!');
end;

procedure TFormAdmin.BtnOpenClick(Sender: TObject);
var
  TempQ: TQuestion;
begin
  if OpenDialog1.Execute then
  begin
    CurrentFilePath := OpenDialog1.FileName;

    // Связывание файла и открытие для чтения
    AssignFile(F, CurrentFilePath);
    Reset(F); // Reset открывает существующий файл

    try
      // Очистка старых данных в памяти
      SetLength(Questions, 0);
      ListBoxQuestions.Items.Clear;

      // Цикл чтения до конца файла (Алгоритм загрузки)
      while not Eof(F) do
      begin
        Read(F, TempQ); // Чтение одной записи

        // Увеличение массива и добавление данных
        SetLength(Questions, Length(Questions) + 1);
        Questions[High(Questions)] := TempQ;

        // Добавление заголовка в визуальный список
        ListBoxQuestions.Items.Add(IntToStr(Length(Questions)) + '. ' +
                                   Copy(string(TempQ.Text), 1, 30) + '...');
      end;

      LabelStatus.Caption := 'Пакет: ' + ExtractFileName(CurrentFilePath);
      ShowMessage('Загружено вопросов: ' + IntToStr(Length(Questions)));

    finally
      CloseFile(F);
    end;
  end;
end;
procedure TFormAdmin.BtnSaveClick(Sender: TObject);
begin
var
  i: Integer;
begin
  // Проверка, открыт ли какой-либо файл для записи
  if CurrentFilePath = '' then
  begin
    ShowMessage('Ошибка: Не выбран файл для сохранения!');
    Exit;
  end;

  // Связывание файловой переменной с путем к файлу
  AssignFile(F, CurrentFilePath);

  try
    // Открытие файла в режиме перезаписи (Rewrite)
    // Это очистит старое содержимое и запишет актуальный массив Questions
    Rewrite(F);

    // Алгоритм записи: проходит по всему динамическому массиву
    for i := 0 to High(Questions) do
    begin
      // Запись каждой структуру TQuestion в файл
      Write(F, Questions[i]);
    end;

    ShowMessage('Пакет успешно сохранен на диск. Вопросов: ' + IntToStr(Length(Questions)));
  finally
    // Закрытие файла, чтобы сохранить данные и освободить ресурсы
    CloseFile(F);
  end;
end;
end;

procedure TFormAdmin.ListBoxQuestionsClick(Sender: TObject);
var
  Idx: Integer;
begin
  Idx := ListBoxQuestions.ItemIndex;
  if Idx >= 0 then
  begin
    Memo1.Text := string(Questions[Idx].Text);
    Edit1.Text := string(Questions[Idx].Answers[0]);
    Edit2.Text := string(Questions[Idx].Answers[1]);
    Edit3.Text := string(Questions[Idx].Answers[2]);
    Edit4.Text := string(Questions[Idx].Answers[3]);

    // Выставление правильных RadioButton
    case Questions[Idx].CorrectIndex of
      0: RadioButton1.Checked := True;
      1: RadioButton2.Checked := True;
      2: RadioButton3.Checked := True;
      3: RadioButton4.Checked := True;
    end;
  end;
end;

end.
