unit AdminUnit;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls;

type
  TQuestion = record
    Text: string[255];          // Текст вопроса
    Answers: array[0..3] of string[100]; // 4 варианта ответа
    CorrectIndex: Integer;       // Номер верного (0..3)
  end;
  TFormAdmin = class(TForm)
    OpenDialog1: TOpenDialog;
    Button1: TButton;
    BtnCreate: TButton;
    Panel1: TPanel;
    ListBoxQuestions: TListBox;
    GroupBox1: TGroupBox;
    LabelStatus: TLabel;
    Memo1: TMemo;
    Edit1: TEdit;
    Button3: TButton;
    Button4: TButton;
    Button5: TButton;
    RadioButton1: TRadioButton;
    Edit2: TEdit;
    RadioButton2: TRadioButton;
    Edit3: TEdit;
    RadioButton3: TRadioButton;
    Edit4: TEdit;
    RadioButton4: TRadioButton;
    SaveDialog1: TSaveDialog;
    procedure BtnCreateClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
    var
      CurrentFilePath: string; // Глобальная переменная для хранения пути к открытому пакет
  end;

var
  FormAdmin: TFormAdmin;

implementation

{$R *.dfm}

procedure TFormAdmin.BtnCreateClick(Sender: TObject);
begin
// 1. Спрашиваем у пользователя, где создать файл
  if SaveDialog1.Execute then
  begin
    CurrentFilePath := SaveDialog1.FileName;

    // 2. Создаем пустой файл.
    // Если JSON, то запишем пустой массив "[]"
    with TStringList.Create do
    try
      Text := '[]';
      SaveToFile(CurrentFilePath, TEncoding.UTF8);
    finally
      Free;
    end;

    // 3. Обновляем визуальную часть
    LabelStatus.Caption := 'Пакет: ' + ExtractFileName(CurrentFilePath);
    ListBoxQuestions.Items.Clear; // Очищаем список (пакет ведь новый)

    // 4. Очищаем поля ввода для первого вопроса
    Memo1.Lines.Clear;
    Edit1.Text := ''; Edit2.Text := '';
    Edit3.Text := ''; Edit4.Text := '';
    RadioButton1.Checked := True; // По умолчанию правильный - первый

    ShowMessage('Новый пакет успешно создан и готов к работе!');
  end;
end;

end.
